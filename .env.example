# ============================================================
# LLM — OpenRouter
# ============================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================
# Aviationstack (Flights) — https://aviationstack.com
# ============================================================
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# ============================================================
# OpenWeatherMap (Weather) — https://openweathermap.org
# ============================================================
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ============================================================
# Tavily (Hotels & Activities Search) — https://tavily.com
# ============================================================
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MCP_PORT=8001

# ============================================================
# PostgreSQL (LangGraph Checkpointing)
# ============================================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/travel_planner

# ============================================================
# LangSmith (Tracing) — https://smith.langchain.com
# ============================================================
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=travel-planning-agent
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# FastAPI Server
# ============================================================
HOST=0.0.0.0
PORT=8000
